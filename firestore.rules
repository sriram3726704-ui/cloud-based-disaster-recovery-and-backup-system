rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile and storage statistics
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Backup metadata records
    // Each backup record is strictly owned by the user who uploaded it
    match /backups/{backupId} {
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.fileName is string
                    && request.resource.data.fileSize is number
                    && request.resource.data.fileSize <= 26214400; // 25 MB max limit
      
      allow read, update, delete: if isAuthenticated() 
                                  && resource.data.userId == request.auth.uid;
    }

    // Disaster Recovery Audit Logs (Activity History)
    match /activity_logs/{logId} {
      allow create: if isAuthenticated() 
                    && request.resource.data.userId == request.auth.uid;
      
      allow read: if isAuthenticated() 
                  && resource.data.userId == request.auth.uid;
                  
      // Audit logs are append-only to preserve disaster recovery audit trail integrity
      allow update, delete: if false;
    }
  }
}
