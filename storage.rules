rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // User folder: Each user has their own isolated directory at users/{userId}/
    match /users/{userId}/{allPaths=**} {
      
      // Allow read (download/restore) only if the requester is the authenticated owner
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow upload (backup) only if the user owns the path, file is under 25MB, and valid content
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 25 * 1024 * 1024; // 25 MB max limit

      // Allow delete only if the user is the authenticated owner
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
